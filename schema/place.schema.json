{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "place.schema.json",
  "title": "Place",
  "description": "Only for places whose state persists. Scenery needs no file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "controlled_by": {
      "type": "string"
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "What the player's actions permanently altered."
    },
    "hidden": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Persists, not yet found."
    },
    "observed_not_explained": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
