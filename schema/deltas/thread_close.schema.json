{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deltas/thread_close.schema.json",
  "title": "thread_close",
  "x-origin": "CLAUDE.md section 3 write trigger",
  "description": "A thread closes. Closed threads stay in the file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "resolution"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "resolution": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "thread_close"
    },
    "note": {
      "type": "string",
      "description": "Why this is durable. Consequences, not events."
    }
  }
}
