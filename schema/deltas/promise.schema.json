{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deltas/promise.schema.json",
  "title": "promise",
  "x-origin": "CLAUDE.md section 3 write trigger",
  "description": "A promise is made, kept, or broken.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "npc",
    "op",
    "what"
  ],
  "properties": {
    "npc": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "op": {
      "enum": [
        "made",
        "kept",
        "broken"
      ]
    },
    "what": {
      "type": "string",
      "minLength": 1
    },
    "by": {
      "enum": [
        "player",
        "npc"
      ]
    },
    "kind": {
      "const": "promise"
    },
    "note": {
      "type": "string",
      "description": "Why this is durable. Consequences, not events."
    }
  }
}
