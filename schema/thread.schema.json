{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thread.schema.json",
  "title": "Thread",
  "description": "Something the player has reason to expect a resolution to.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "summary",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "resolution": {
      "type": "string",
      "description": "Set when closed. Closed threads stay in the file."
    }
  }
}
