#!/usr/bin/env python3
"""Check world/ against the schemas. Exit non-zero with a readable list."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _state  # noqa: E402


def main(argv):
    base = argv[1] if len(argv) > 1 else _state.WORLD
    try:
        state = _state.load_state(base)
    except Exception as e:
        print("cannot load %s: %s" % (base, e), file=sys.stderr)
        return 2
    errors = _state.validate_state(state)
    if errors:
        print("%d violation%s in %s:" % (len(errors), "" if len(errors) == 1 else "s",
                                         os.path.relpath(base, _state.ROOT)),
              file=sys.stderr)
        for e in errors:
            print("  " + e, file=sys.stderr)
        return 1
    print("world/ is valid (%d npcs, %d places, %d threads)"
          % (len(state["npcs"]), len(state["places"]), len(state["threads"])))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
