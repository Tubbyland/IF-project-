#!/usr/bin/env python3
"""Show the event log, newest last, with hashes."""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _state  # noqa: E402


def main(argv):
    verbose = "-v" in argv or "--verbose" in argv
    entries = _state.read_log()
    if not entries:
        print("log is empty (state is genesis)")
        return 0
    for e in entries:
        d = e["delta"]
        note = d.get("note") or d.get("reason") or ""
        print("#%-4d %-20s delta:%s state:%s  %s"
              % (e["seq"], e["kind"], e["delta_hash"][:10],
                 e["state_hash"][:10], note))
        if verbose:
            print(json.dumps(d, indent=4, ensure_ascii=False, sort_keys=True))
    print("\n%d deltas. head state %s" % (len(entries), entries[-1]["state_hash"]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
